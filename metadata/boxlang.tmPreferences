<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>BoxLang Symbols</string>
    <key>scope</key>
    <string>source.boxlang, source.boxlang.script</string>
    <key>settings</key>
    <dict>
        <key>showInIndexedSymbolList</key>
        <integer>1</integer>
        <key>showInSymbolList</key>
        <integer>1</integer>
        <key>symbolTransformation</key>
        <string>
            s/^.*\b(class)\s+(\w+).*/$1: $2/g;
            s/^.*\b(function)\s+(\w+).*/  $1: $2/g;
            s/^.*\b(property)\s+(\w+).*/    $1: $2/g;
        </string>
    </dict>
</dict>
</plist>
