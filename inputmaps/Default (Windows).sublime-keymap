[
  // ctrl+alt+a <cfabort>/<:abort>
  {
    "keys": ["ctrl+alt+a"],
    "command": "insert_snippet",
    "args": {"contents": "<cfabort>"},
    "context": [
      {"key": "selector", "operator": "equal", "operand": "embedding.boxlang"},
      {"key": "selector", "operator": "not_equal", "operand": "source.boxlang.script"}
    ]
  },
  {
    "keys": ["ctrl+alt+a"],
    "command": "insert_snippet",
    "args": {"contents": "abort;"},
    "context": [
      {"key": "selector", "operator": "equal", "operand": "source.boxlang.script"}
    ]
  },
  // ctrl+alt+d writeDump()/dump();
  {
    "keys": ["ctrl+alt+d"],
    "command": "insert_snippet",
    "args": {"contents": "writeDump(${0:$SELECTION});"},
    "context": [
      {"key": "selector", "operator": "equal", "operand": "source.boxlang.script"}
    ]
  },
  // ctrl+alt+d  <cfdump var="##">/<:dump var="##">
  {
    "keys": ["ctrl+alt+d"],
    "command": "insert_snippet",
    "args": {"contents": "<cfdump var=\"#${1:$SELECTION}#\">"},
    "context": [
      {"key": "selector", "operator": "equal", "operand": "embedding.boxlang"},
      {"key": "selector", "operator": "not_equal", "operand": "source.boxlang.script"}
    ]
  },
  // ctrl+shift+o  <cfoutput>/<:output>
  {
    "keys": ["ctrl+shift+o"],
    "command": "insert_snippet",
    "args": {"contents": "<cfoutput>${1:$SELECTION}</cfoutput>"},
    "context": [
      {"key": "selector", "operand": "embedding.boxlang"},
      {"key": "selector", "operator": "not_equal", "operand": "source.boxlang.script"}
    ]
  },
  // ctrl+shift+o  writeOutput();
  {
    "keys": ["ctrl+shift+o"],
    "command": "insert_snippet",
    "args": {"contents": "writeOutput(${1:$SELECTION});"},
    "context": [
      {"key": "selector", "operand": "source.boxlang.script" }
    ]
  },
  // shift+3 wrap selection with hash
  {
    "keys": ["#"],
    "command": "insert_snippet",
    "args": {"contents": "#${0:$SELECTION}#"},
    "context": [
      {"key": "setting.auto_match_enabled", "operator": "equal", "operand":true},
      {"key": "selection_empty", "operator": "equal", "operand":false, "match_all":true},
      {"key": "selector", "operator": "equal", "operand": "string.quoted.double.boxlang,string.quoted.single.boxlang,meta.scope.cfoutput.boxlang", "match_all":true}
    ]
  },
  // f1 docs lookup
  {
    "keys": ["f1"],
    "command": "boxlang_inline_documentation",
    "args": {"doc_type": "inline_doc"},
    "context": [
      {"key": "selector", "operator": "equal", "operand": "embedding.boxlang", "match_all":true}
    ]
  },
  // method preview
  {
    "keys": ["shift+f1"],
    "command": "boxlang_preview_method",
    "context": [
      {"key": "selector", "operator": "equal", "operand": "embedding.boxlang", "match_all":true}
    ]
  },
  // close tags
  {
    "keys": ["/"],
    "command": "close_boxlang_tag",
    "context": [
      {"key": "selector", "operator": "equal", "operand": "embedding.boxlang - string.quoted - comment - source.boxlang.script", "match_all":true},
      {"key": "preceding_text", "operator": "regex_match", "operand": ".*<$", "match_all":true},
      {"key": "following_text", "operator": "not_regex_match", "operand": "^[A-Za-z\\-_]+>.*", "match_all":true},
      {"key": "setting.auto_close_tags"}
    ]
  },
  {
    "keys": [">"],
    "command": "boxlang_auto_insert_closing_tag",
    "context": [
      {"key": "selector", "operator": "equal", "operand": "meta.tag.boxlang - comment, meta.tag.custom.boxlang - comment", "match_all":true},
      {"key": "selection_empty", "operator": "equal", "operand": true, "match_all": true},
      {"key": "preceding_text", "operator": "regex_match", "operand": ".*[^/]$", "match_all":true}
    ]
  },
  {
    "keys": ["enter"],
    "command": "boxlang_between_tag_pair",
    "context":
    [
      {"key": "selector", "operator": "equal", "operand": "meta.tag.boxlang - comment - source.boxlang.script, meta.tag.custom.boxlang - comment - source.boxlang.script", "match_all":true},
      {"key": "selection_empty", "operator": "equal", "operand": true, "match_all": true},
      {"key": "preceding_text", "operator": "regex_match", "operand": ".*>$", "match_all":true},
      {"key": "following_text", "operator": "regex_match", "operand": "^</.*", "match_all":true}
    ]
  },
  {
    "keys": ["ctrl+f1"],
    "command": "boxlang_toggle_controller_view",
    "context": [
      {"key": "selector", "operator": "equal", "operand": "embedding.boxlang", "match_all":true}
    ]
  },
  {
    "keys": ["shift+alt+d"],
    "command": "boxlang_di_property",
    "context": [
      {"key": "selector", "operator": "equal", "operand": "source.boxlang meta.class", "match_all":true}
    ]
  },
  {
    "keys": ["shift+alt+f"],
    "command": "boxlang_format",
    // "args": {"current_method": false},
    "context": [
      {"key": "selector", "operator": "equal", "operand": "embedding.boxlang", "match_all":true}
    ]
  },
  {
    "keys": [","],
    "command": "boxlang_update_completion_doc",
    "context": [
      {"key": "selector", "operator": "equal", "operand": "source.boxlang.script meta.function-call.arguments", "match_all":true},
      {"key": "selection_empty", "operator": "equal", "operand": true, "match_all": true}
    ]
  }
]
