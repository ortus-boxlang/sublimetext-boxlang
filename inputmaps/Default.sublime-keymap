[
    // Inline documentation
    {
        "keys": ["f1"],
        "command": "boxlang_inline_documentation",
        "args": {"doc_type": "inline_doc"},
        "context": [{"key": "selector", "operator": "equal", "operand": "source.boxlang"}]
    },

    // Controller/View toggle
    {
        "keys": ["ctrl+f1"],
        "command": "boxlang_controller_view_toggle",
        "context": [{"key": "selector", "operator": "equal", "operand": "source.boxlang"}]
    },

    // Insert writeDump()
    {
        "keys": ["ctrl+alt+d"],
        "command": "insert_snippet",
        "args": {"contents": "writeDump(${1:var});"},
        "context": [{"key": "selector", "operator": "equal", "operand": "source.boxlang"}]
    },

    // Insert writeOutput()
    {
        "keys": ["ctrl+shift+o"],
        "command": "insert_snippet",
        "args": {"contents": "writeOutput(${1:output});"},
        "context": [{"key": "selector", "operator": "equal", "operand": "source.boxlang"}]
    },

    // Insert abort
    {
        "keys": ["ctrl+alt+a"],
        "command": "insert_snippet",
        "args": {"contents": "abort;"},
        "context": [{"key": "selector", "operator": "equal", "operand": "source.boxlang"}]
    },

    // Format code
    {
        "keys": ["shift+alt+f"],
        "command": "boxlang_format",
        "context": [{"key": "selector", "operator": "equal", "operand": "source.boxlang"}]
    },

    // Inject property (DI)
    {
        "keys": ["shift+alt+d"],
        "command": "boxlang_inject_property",
        "context": [{"key": "selector", "operator": "equal", "operand": "source.boxlang"}]
    },

    // Navigate parse errors
    {
        "keys": ["f4"],
        "command": "boxlang_next_error",
        "context": [{"key": "selector", "operator": "equal", "operand": "source.boxlang"}]
    },
    {
        "keys": ["shift+f4"],
        "command": "boxlang_prev_error",
        "context": [{"key": "selector", "operator": "equal", "operand": "source.boxlang"}]
    },

    // Build and run
    {
        "keys": ["ctrl+b"],
        "command": "build",
        "context": [{"key": "selector", "operator": "equal", "operand": "source.boxlang"}]
    },
    {
        "keys": ["super+b"],
        "command": "build",
        "context": [{"key": "selector", "operator": "equal", "operand": "source.boxlang"}]
    },

    // Wrap selection in #hash#
    {
        "keys": ["#"],
        "command": "boxlang_wrap_hash",
        "context": [
            {"key": "selector", "operator": "equal", "operand": "source.boxlang"},
            {"key": "selection_empty", "operator": "equal", "operand": false, "match_all": true}
        ]
    }
]
