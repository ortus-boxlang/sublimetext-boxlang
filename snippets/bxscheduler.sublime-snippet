<snippet>
    <content><![CDATA[${1:scheduler} = schedulerNew( name = "${2:my-scheduler}", timezone = "${3:UTC}" )

${1:scheduler}.task( "${4:task-name}" )
	.call( () => ${5:doWork()} )
	.${6:everyHour}()
	.onOneServer()${0}]]></content>
