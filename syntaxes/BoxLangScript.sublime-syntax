%YAML 1.2
---

name: BoxLang Script
scope: source.boxlang.script
version: 2

file_extensions:
  - bxs

variables:
  identifier: '[_$[:alpha:]][_$[:alnum:]]*'
  dot_path_identifier: '[_$[:alnum:]][_$[:alnum:].]*'
  constant_identifier: '[[:upper:]][_$[:digit:][:upper:]]*\b'
  reserved_word: |-
    (?x:
      break|case|catch|continue|default|do|else|finally|for|function|if|import|in|new|return|
      super|switch|this|try|var|void|while|null|true|false|class|interface|extends|implements|
      attempt|retry|transaction|lock|abort|throw|rethrow|include|property|component|abstract|
      final|static|public|private|package|remote|annotation
    )\b

  non_reserved_identifier: (?:(?!{{reserved_word}}){{identifier}})

  access_modifier: \b(private|package|public|remote)\b
  storage_modifier: \b(static|final|abstract)\b
  storage_types: \b(?:any|array|binary|boolean|component|date|guid|numeric|query|string|struct|xml|uuid|void)\b
  function_declaration_lookahead: |-
    (?x:
      ({{access_modifier}}\s+)?
      ({{storage_modifier}}\s+)?
      ({{dot_path_identifier}}(\[\])?\s+)?
      \bfunction\b
    )

  block_comment_contents: (?:(?:[^*]|\*(?!/))*)
  block_comment: (?:/\*{{block_comment_contents}}\*/)
  nothing: (?:(?:\s|{{block_comment}})*)

contexts:
  prototype:
    - include: comments

  else-pop:
    - match: (?=\S)
      pop: true

  immediately-pop:
    - meta_include_prototype: false
    - match: ''
      pop: true

  main:
    - match: '\)|\}|\]'
      scope: invalid.illegal.stray-bracket-end.boxlang
    - include: import-statement
    - include: statements

  statements:
    - match: '\)|\}|\]'
      scope: invalid.illegal.stray-bracket-end.boxlang
      pop: true
    - match: (?=\S)
      push: statement

  statement:
    - match: \;
      scope: punctuation.terminator.statement.empty.boxlang
      pop: true
    - include: class-declaration
    - include: function-declaration
    - include: variable-declaration
    - include: conditional
    - include: block
    - include: flow-control
    - include: expression-statement

  comments:
    - match: /\*\*(?!/|\*)
      scope: punctuation.definition.comment.boxlang
      push:
        - meta_include_prototype: false
        - meta_scope: comment.block.documentation.boxlang
        - match: \*/
          scope: punctuation.definition.comment.boxlang
          pop: true
    - match: /\*
      scope: punctuation.definition.comment.boxlang
      push:
        - meta_include_prototype: false
        - meta_scope: comment.block.boxlang
        - match: \*/
          scope: punctuation.definition.comment.boxlang
          pop: true
    - match: //
      scope: punctuation.definition.comment.boxlang
      push:
        - meta_include_prototype: false
        - meta_scope: comment.line.double-slash.boxlang
        - match: \n
          pop: true

  import-statement:
    - match: \b(import)\b
      scope: keyword.control.import.boxlang
      push:
        - match: \;
          scope: punctuation.terminator.statement.boxlang
          pop: true
        - match: '{{dot_path_identifier}}'
          scope: variable.other.import.boxlang

  class-declaration:
    - match: \b(class)\b
      scope: keyword.declaration.class.boxlang storage.type.class.boxlang
      push:
        - match: \{
          scope: punctuation.section.block.begin.boxlang
          set: class-body
        - match: \b(extends)\b
          scope: keyword.declaration.extends.boxlang
        - match: \b(implements)\b
          scope: keyword.declaration.implements.boxlang
        - match: '{{identifier}}'
          scope: entity.name.class.boxlang

  class-body:
    - meta_scope: meta.class.body.boxlang
    - match: \}
      scope: punctuation.section.block.end.boxlang
      pop: true
    - include: function-declaration
    - include: property-declaration

  function-declaration:
    - match: '{{function_declaration_lookahead}}'
      scope: meta.function.declaration.boxlang
      push:
        - meta_scope: meta.function.declaration.boxlang
        - match: '(?=\{)'
          set: function-body
        - match: \bfunction\b
          scope: keyword.declaration.function.boxlang storage.type.function.boxlang
        - match: '{{identifier}}'
          scope: entity.name.function.boxlang
        - match: \(
          scope: punctuation.section.group.begin.boxlang
          push: function-params
        - match: ':'
          scope: punctuation.separator.type.boxlang
          push: return-type

  function-params:
    - meta_scope: meta.function.parameters.boxlang
    - match: \)
      scope: punctuation.section.group.end.boxlang
      pop: true
    - match: '{{identifier}}'
      scope: variable.parameter.function.boxlang
    - match: ':'
      scope: punctuation.separator.type.boxlang
      push: param-type
    - match: ','
      scope: punctuation.separator.parameters.boxlang

  param-type:
    - meta_scope: storage.type.boxlang
    - match: '(?=[,)])'
      pop: true
    - match: '{{identifier}}'

  return-type:
    - meta_scope: storage.type.boxlang
    - match: '(?=[\{(])'
      pop: true
    - match: '{{identifier}}'

  function-body:
    - match: \{
      scope: punctuation.section.block.begin.boxlang
      set:
        - meta_scope: meta.function.body.boxlang
        - match: \}
          scope: punctuation.section.block.end.boxlang
          pop: true
        - include: statements

  variable-declaration:
    - match: \b(var)\b
      scope: keyword.declaration.var.boxlang storage.type.boxlang
      push:
        - match: \;
          scope: punctuation.terminator.statement.boxlang
          pop: true
        - match: '{{identifier}}'
          scope: variable.other.readwrite.boxlang
        - match: '='
          scope: keyword.operator.assignment.boxlang
          push: expression

  conditional:
    - match: \b(if|else\s+if|else|switch|case|default)\b
      scope: keyword.control.conditional.boxlang
      push:
        - match: \{
          scope: punctuation.section.block.begin.boxlang
          set:
            - meta_scope: meta.block.boxlang
            - match: \}
              scope: punctuation.section.block.end.boxlang
              pop: true
            - include: statements
        - match: \(
          scope: punctuation.section.group.begin.boxlang
          push:
            - meta_scope: meta.group.boxlang
            - match: \)
              scope: punctuation.section.group.end.boxlang
              pop: true
            - include: expression

  flow-control:
    - match: \b(break|continue)\b
      scope: keyword.control.flow.boxlang
      set: expect-semicolon
    - match: \b(return)\b
      scope: keyword.control.flow.return.boxlang
      set: restricted-production
    - match: \b(throw|rethrow)\b
      scope: keyword.control.flow.throw.boxlang
      set: restricted-production
    - match: \b(abort)\b
      scope: keyword.control.flow.boxlang
      set: expect-semicolon

  expect-semicolon:
    - match: \;
      scope: punctuation.terminator.statement.boxlang
      pop: true
    - match: (?=\S)
      push: expression

  restricted-production:
    - match: \;
      scope: punctuation.terminator.statement.boxlang
      pop: true
    - match: (?=\S)
      push: expression

  block:
    - match: \{
      scope: punctuation.section.block.begin.boxlang
      push:
        - meta_scope: meta.block.boxlang
        - match: \}
          scope: punctuation.section.block.end.boxlang
          pop: true
        - include: statements

  expression-statement:
    - match: (?=\S)
      push:
        - match: \;
          scope: punctuation.terminator.statement.boxlang
          pop: true
        - include: expression

  expression:
    - include: literal
    - include: function-call
    - include: member-access
    - include: operators
    - include: parentheses
    - include: array-literal
    - include: struct-literal

  literal:
    - match: \b(true|false|null)\b
      scope: constant.language.boxlang
    - match: \b([0-9]+\.?[0-9]*)\b
      scope: constant.numeric.boxlang
    - match: '"'
      scope: punctuation.definition.string.begin.boxlang
      push: double-quoted-string
    - match: "'"
      scope: punctuation.definition.string.begin.boxlang
      push: single-quoted-string

  double-quoted-string:
    - meta_scope: string.quoted.double.boxlang
    - match: '"'
      scope: punctuation.definition.string.end.boxlang
      pop: true
    - match: '\\.'
      scope: constant.character.escape.boxlang

  single-quoted-string:
    - meta_scope: string.quoted.single.boxlang
    - match: "'"
      scope: punctuation.definition.string.end.boxlang
      pop: true

  function-call:
    - match: '{{identifier}}\s*(?=\()'
      scope: meta.function-call.boxlang entity.name.function.boxlang
      push: function-call-args

  function-call-args:
    - match: \(
      scope: punctuation.section.group.begin.boxlang
      set:
        - meta_scope: meta.function-call.arguments.boxlang
        - match: \)
          scope: punctuation.section.group.end.boxlang
          pop: true
        - include: expression

  member-access:
    - match: \.
      scope: punctuation.accessor.boxlang
      push:
        - match: '{{identifier}}'
          scope: variable.other.property.boxlang
          pop: true

  operators:
    - match: '===|!==|==|!=|<=|>=|<|>'
      scope: keyword.operator.comparison.boxlang
    - match: '&&|\|\||!'
      scope: keyword.operator.logical.boxlang
    - match: '=>|->'
      scope: keyword.operator.arrow.boxlang
    - match: '[+\-*/%]=?'
      scope: keyword.operator.arithmetic.boxlang
    - match: '='
      scope: keyword.operator.assignment.boxlang

  parentheses:
    - match: \(
      scope: punctuation.section.group.begin.boxlang
      push:
        - meta_scope: meta.group.boxlang
        - match: \)
          scope: punctuation.section.group.end.boxlang
          pop: true
        - include: expression

  array-literal:
    - match: \[
      scope: punctuation.section.array.begin.boxlang
      push:
        - meta_scope: meta.array.literal.boxlang
        - match: \]
          scope: punctuation.section.array.end.boxlang
          pop: true
        - include: expression

  struct-literal:
    - match: \{
      scope: punctuation.section.struct.begin.boxlang
      push:
        - meta_scope: meta.struct.literal.boxlang
        - match: \}
          scope: punctuation.section.struct.end.boxlang
          pop: true
        - match: '{{identifier}}\s*:'
          captures:
            0: meta.struct-literal.key.boxlang
            1: variable.other.readwrite.boxlang
            2: punctuation.separator.key-value.boxlang
        - include: expression

  property-declaration:
    - match: \b(property)\b
      scope: keyword.declaration.property.boxlang
      push:
        - match: \;
          scope: punctuation.terminator.statement.boxlang
          pop: true
        - match: '{{identifier}}'
          scope: variable.other.property.boxlang
