%YAML 1.2
---

name: BoxLang Markup
scope: embedding.boxlang.markup
version: 2

file_extensions:
  - bxm

variables:
  identifier: '[_$[:alpha:]][_$[:alnum:]]*'
  attribute_name: '[_[:alpha:]][[:alnum:]_\-:]*'
  boxlang_scope: \b(this|variables|thread|session|client|server|cgi|form|url|cookie|application|request|arguments|super)\b

  block_comment_contents: (?:(?:[^*]|\*(?!/))*)
  block_comment: (?:/\*{{block_comment_contents}}\*/)

contexts:
  prototype:
    - include: comments

  else-pop:
    - match: (?=\S)
      pop: true

  immediately-pop:
    - meta_include_prototype: false
    - match: ''
      pop: true

  main:
    - include: comments
    - include: bx-function
    - include: bx-output
    - include: bx-script
    - include: bx-generic-closing-tag
    - include: bx-generic-tag
    - include: interpolation
    - match: '(##)'
      scope: keyword.operator.escape.hash.boxlang
    - include: html-with-boxlang

  html-with-boxlang:
    - include: scope:text.html.basic
      with_prototype:
        - include: bx-function
        - include: bx-output
        - include: bx-script
        - include: bx-generic-closing-tag
        - include: bx-generic-tag
        - include: interpolation
        - match: '(##)'
          scope: keyword.operator.escape.hash.boxlang

  html-with-boxlang-output:
    - include: scope:text.html.basic
      with_prototype:
        - match: (</)(bx:output)(>)
          captures:
            1: punctuation.definition.tag.begin.boxlang
            2: keyword.control.boxlang
            3: punctuation.definition.tag.end.boxlang
          pop: true
        - include: bx-function
        - include: bx-output
        - include: bx-script
        - include: bx-generic-closing-tag
        - include: bx-generic-tag
        - include: interpolation
        - match: '(##)'
          scope: keyword.operator.escape.hash.boxlang

  interpolation:
    - match: '#(?!#)'
      scope: keyword.operator.interpolation.begin.boxlang
      push:
        - meta_scope: meta.interpolation.boxlang
        - match: '#'
          scope: keyword.operator.interpolation.end.boxlang
          pop: true
        - include: scope:source.boxlang

  bx-generic-closing-tag:
    - match: (</)(bx:)([[:alpha:]][[:alnum:]_\-]*)(\s*)(>)
      captures:
        1: punctuation.definition.tag.begin.boxlang
        2: keyword.control.boxlang
        3: entity.name.tag.boxlang
        5: punctuation.definition.tag.end.boxlang

  comments:
    - match: /\*\*(?!/|\*)
      scope: punctuation.definition.comment.boxlang
      push:
        - meta_include_prototype: false
        - meta_scope: comment.block.documentation.boxlang
        - match: \*/
          scope: punctuation.definition.comment.boxlang
          pop: true
    - match: /\*
      scope: punctuation.definition.comment.boxlang
      push:
        - meta_include_prototype: false
        - meta_scope: comment.block.boxlang
        - match: \*/
          scope: punctuation.definition.comment.boxlang
          pop: true
    - match: '(?i)<\!---'
      scope: punctuation.definition.comment.begin.boxlang
      push:
        - meta_include_prototype: false
        - meta_scope: comment.block.boxlang
        - match: '--->'
          scope: punctuation.definition.comment.end.boxlang
          pop: true
    - match: //
      scope: punctuation.definition.comment.boxlang
      push:
        - meta_include_prototype: false
        - meta_scope: comment.line.double-slash.boxlang comment.block.documentation.boxlang
        - match: \n
          pop: true

  bx-generic-tag:
    - match: (<)(bx:)([[:alpha:]][[:alnum:]_\-]*)
      captures:
        1: punctuation.definition.tag.begin.boxlang
        2: keyword.control.boxlang
        3: entity.name.tag.boxlang
      push:
        - meta_scope: meta.tag.boxlang
        - match: (/?>)
          scope: punctuation.definition.tag.end.boxlang
          pop: true
        - include: tag-attributes

  tag-attributes:
    - match: (\w[\w\-]*)\s*(=)\s*(")
      captures:
        1: entity.other.attribute-name.boxlang
        2: punctuation.separator.key-value.boxlang
        3: punctuation.definition.string.begin.boxlang
      push:
        - meta_scope: string.quoted.double.boxlang
        - match: '"'
          scope: punctuation.definition.string.end.boxlang
          pop: true
        - match: '\\.'
          scope: constant.character.escape.boxlang
    - match: (\w[\w\-]*)\s*(=)\s*(')
      captures:
        1: entity.other.attribute-name.boxlang
        2: punctuation.separator.key-value.boxlang
        3: punctuation.definition.string.begin.boxlang
      push:
        - meta_scope: string.quoted.single.boxlang
        - match: "'"
          scope: punctuation.definition.string.end.boxlang
          pop: true
        - match: '\\.'
          scope: constant.character.escape.boxlang
    - match: (\w[\w\-]*)\s*(=)
      captures:
        1: entity.other.attribute-name.boxlang
        2: punctuation.separator.key-value.boxlang
      push: tag-attribute-value
    - match: (\w[\w\-]*)
      scope: entity.other.attribute-name.boxlang

  tag-attribute-value:
    - match: (?i)\b(true|false)\b
      scope: constant.language.boolean.boxlang
      pop: true
    - match: '{{identifier}}'
      scope: variable.other.tag-attribute.boxlang
      pop: true
    - include: else-pop

  bx-function:
    - match: (<)(bx:function\b)
      captures:
        1: punctuation.definition.tag.begin.boxlang
        2: keyword.control.boxlang
      push:
        - meta_scope: meta.tag.function.boxlang
        - match: '>'
          scope: punctuation.definition.tag.end.boxlang
          set: bx-function-body
        - include: bx-function-name
        - include: tag-attributes

  bx-function-name:
    - match: (?i:\bname\b)
      scope: entity.other.attribute-name.boxlang
      push:
        - match: '='
          scope: punctuation.separator.key-value.boxlang
          set:
            - match: '"'
              scope: punctuation.definition.string.begin.boxlang
              set:
                - meta_scope: string.quoted.double.boxlang
                - match: '"'
                  scope: punctuation.definition.string.end.boxlang
                  pop: true
                - match: '[^"]+'
                  scope: entity.name.function.boxlang
            - match: "'"
              scope: punctuation.definition.string.begin.boxlang
              set:
                - meta_scope: string.quoted.single.boxlang
                - match: "'"
                  scope: punctuation.definition.string.end.boxlang
                  pop: true
                - match: "[^']+"
                  scope: entity.name.function.boxlang
            - include: else-pop
        - include: else-pop

  bx-function-body:
    - meta_content_scope: source.boxlang
    - match: (</)(bx:function)(>)
      captures:
        1: punctuation.definition.tag.begin.boxlang
        2: keyword.control.boxlang
        3: punctuation.definition.tag.end.boxlang
      pop: true
    - include: scope:source.boxlang

  bx-output:
    - match: (<)(bx:output\b)
      captures:
        1: punctuation.definition.tag.begin.boxlang
        2: keyword.control.boxlang
      push:
        - meta_scope: meta.tag.output.boxlang
        - match: '>'
          scope: punctuation.definition.tag.end.boxlang
          set: bx-output-body
        - include: tag-attributes

  bx-output-body:
    - match: (</)(bx:output)(>)
      captures:
        1: punctuation.definition.tag.begin.boxlang
        2: keyword.control.boxlang
        3: punctuation.definition.tag.end.boxlang
      pop: true
    - include: html-with-boxlang-output

  bx-script:
    - match: (<)(bx:script\b)
      captures:
        1: punctuation.definition.tag.begin.boxlang
        2: keyword.control.boxlang
      push:
        - meta_scope: meta.tag.script.boxlang
        - match: '>'
          scope: punctuation.definition.tag.end.boxlang
          set: bx-script-body
        - include: tag-attributes

  bx-script-body:
    - meta_content_scope: source.boxlang
    - match: (</)(bx:script)(>)
      captures:
        1: punctuation.definition.tag.begin.boxlang
        2: keyword.control.boxlang
        3: punctuation.definition.tag.end.boxlang
      pop: true
    - include: scope:source.boxlang
