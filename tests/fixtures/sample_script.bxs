// BoxLang Script File
import model.UserService;
import model.Config;

var config = new Config();
var userService = new UserService(config);

var users = userService.find({ active: true });

for (user in users) {
    writeOutput(user.name & "<br>");
}

function greet(string name) => string {
    return "Hello, #name#!";
}

writeDump(greet("World"));
